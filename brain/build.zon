// The brain build wiring for the conkers cartridge: the modules it compiles
// into a brain, the tests that hold them, and the steps that run them. The
// brain's build (vendor/semantos-core/runtime/semantos-brain/build/cartridges.zig)
// reads this; paths are relative to this file. An import names one of the
// modules below or a module the brain exposes to cartridges.
//
// This cartridge lives outside the submodule's cartridges/ tree, so it is
// passed to the brain build as a -Dcartridge dir:
//
//   cd vendor/semantos-core/runtime/semantos-brain
//   zig build test -Dcartridge=/abs/path/to/conkers
//
// brain/test.sh runs the same modules under plain `zig test` without the brain.
.{
    .id = "conkers",
    // Its row in the boot table; rows run in `order` (jambox 10, chess 20).
    .boot = .{ .order = 30, .module = "conkers_boot_spec" },
    .modules = .{
        // hash160 for the lock's owner pin: the cell-engine's std-only RIPEMD-160,
        // used by reference rather than copied.
        .{ .name = "conkers_ripemd160", .root = "../vendor/semantos-core/core/cell-engine/src/ripemd160.zig" },
        // ── The pure tier, a byte-for-byte port of mirror/src ────────────
        .{ .name = "conkers_derive", .root = "derive.zig" },
        .{ .name = "conkers_cells", .root = "cells.zig" },
        .{ .name = "conkers_physics", .root = "physics.zig", .imports = .{"conkers_derive"} },
        .{ .name = "conkers_script", .root = "script.zig", .imports = .{"conkers_ripemd160"} },
        .{
            .name = "conkers_verbs",
            .root = "verbs.zig",
            .imports = .{ "conkers_derive", "conkers_cells", "conkers_physics", "conkers_script" },
        },
        // spec/vectors.json, generated by `pnpm --filter @conkers/mirror vectors`:
        // data for @embedFile, the byte-exact contract between the tiers.
        .{ .name = "conkers_vectors", .root = "../spec/vectors.json" },
        // ── The brain surface: four verbs through verb_dispatcher ────────
        .{
            .name = "conkers_walkers",
            .root = "walkers.zig",
            .imports = .{ "conkers_verbs", "conkers_cells", "conkers_vectors", "verb_dispatcher" },
        },
        .{
            .name = "conkers_boot_spec",
            .root = "boot_spec.zig",
            .imports = .{ "cartridge_spec", "conkers_walkers", "verb_dispatcher" },
        },
    },
    .tests = .{
        .{ .module = "conkers_derive", .steps = .{ "test", "test-substrate" } },
        .{ .module = "conkers_cells", .steps = .{ "test", "test-substrate" } },
        .{ .module = "conkers_physics", .steps = .{ "test", "test-substrate" } },
        .{ .module = "conkers_script", .steps = .{ "test", "test-substrate" } },
        .{ .module = "conkers_verbs", .steps = .{ "test", "test-substrate" } },
        .{ .module = "conkers_walkers", .steps = .{ "test", "test-substrate" } },
        .{ .module = "conkers_boot_spec", .steps = .{ "test", "test-substrate" } },
        // Every entry of spec/vectors.json re-derived, re-computed and re-encoded here.
        .{
            .root = "vectors_test.zig",
            .imports = .{ "conkers_vectors", "conkers_derive", "conkers_cells", "conkers_physics", "conkers_script", "conkers_verbs" },
            .steps = .{ "test", "test-substrate" },
        },
    },
}
